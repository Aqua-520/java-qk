<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wcy.mapper.UserMapper">
    <!-- 编写查询语句 Page<User> getUserListByLimit(IPage<User> page, UserQueryDTO userDto); -->
    <select id="getUserListByLimit" resultType="com.wcy.entity.User">
        select
        u.id,
        u.name,
        u.username,
        u.image,
        u.phone,
        u.status,
        u.update_time,
        d.name AS deptName,
        r.name AS roleName
        from
        user u
        left join dept d on u.dept_id = d.id
        left join role r on u.role_id = r.id
        <where>
            <if test="userDto.name != null and userDto.name != ''">
                and u.name like concat('%', #{userDto.name}, '%')
            </if>
            <if test="userDto.status != null">
                and u.status = #{userDto.status}
            </if>
            <if test="userDto.deptId != null">
                and u.dept_id = #{userDto.deptId}
            </if>
            <!-- 提示：你漏了 phone 的查询条件，如果需要请加上下面这段 -->
            <!--
            <if test="userDto.phone != null and userDto.phone != ''">
                and u.phone = #{userDto.phone}
            </if>
            -->
        </where>
        order by u.update_time desc
    </select>
</mapper>